# Kalshi API (https://kalshi.com/account/profile → API Keys)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private.key
KALSHI_ENV=prod
# prod base: https://api.elections.kalshi.com/trade-api/v2
# demo base: https://demo-api.kalshi.co/trade-api/v2

# Official CME CF Bitcoin Real Time Index (BRTI).
# This must return JSON containing an explicit BRTI source, price, and timestamp.
# Required for official mode and all LIVE entry eligibility.
CF_BENCHMARK_URL=kalshi://BRTI
CF_BENCHMARK_API_KEY=
CF_BENCHMARK_API_KEY_HEADER=Authorization
CF_BENCHMARK_API_KEY_PREFIX=Bearer
# official | constituent_proxy | kalshi_passthrough
# kalshi_passthrough uses your Kalshi API key via /cfbenchmarks/values?id=BRTI
BENCHMARK_MODE=kalshi_passthrough

# Polymarket (optional; cross-venue execution remains disabled by default)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=1

# Risk / execution
DRY_RUN=true
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=100
MIN_BOOK_DEPTH_USD=25

# Optional overrides
RISK_FREE_RATE=0.05
POLL_INTERVAL_SEC=1.0

# ---------------------------------------------------------------------------
# Standalone hourly BTC bot (kalshi_btc_bot.py)
# ---------------------------------------------------------------------------
# Mode: "paper" (simulated fills, real market data) or "live" (real orders)
KALSHI_TRADING_MODE=paper
# Alias for KALSHI_API_KEY_ID (either name works)
# KALSHI_API_KEY=your_key_id_here
KALSHI_REST_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_BASE_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
KALSHI_BTC_SERIES_TICKER=KXBTC
# Balanced defaults (fewer, higher-quality signals)
MIN_TIME_LEFT_MINUTES=8
MAX_TIME_LEFT_MINUTES=45
IMBALANCE_RATIO_THRESHOLD=2.2
IMBALANCE_EXTREME_THRESHOLD=3.0
PRICE_BAND_LOW=32
PRICE_BAND_HIGH=62
MOMENTUM_DELTA_CENTS=2.0
REQUIRE_MOMENTUM=true
ALLOW_ONE_SIDED_BOOKS=false
MIN_SIDE_DEPTH=150
MAX_MARKETS_PER_SCAN=40
DEPTH_LEVELS=3
MAX_CONTRACTS_PER_TRADE=5
MAX_DOLLARS_PER_TRADE=5.00
DAILY_LOSS_LIMIT=25.00
MAX_OPEN_POSITIONS=1
COOLDOWN_SECONDS=120
STARTING_BANKROLL=100.00
ORDER_TYPE=limit
POLL_INTERVAL_SECONDS=15
LOG_LEVEL=INFO
LOG_FILE=kalshi_bot.log